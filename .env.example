# Public browser configuration only. Never place a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Set only after the exact production notice language has qualified-counsel approval.
VITE_PRIVACY_NOTICE_VERSION=

# Stripe webhook configuration (server-side only, never exposed to browser)
# Enable signature verification in production, disable only for local testing
BRITELINK_STRIPE_WEBHOOK_VERIFICATION_ENABLED=true
BRITELINK_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Trusted monitoring environment only. Never expose the monitor JWT to Vite/browser code.
BRITELINK_SUPABASE_URL=https://your-project.supabase.co
BRITELINK_SUPABASE_ANON_KEY=your-public-anon-key
BRITELINK_MONITOR_JWT=short-lived-dedicated-admin-access-token
BRITELINK_MONITOR_HOUSEHOLD_ID=household-uuid

# Staging-only isolation check. Use two distinct synthetic-household users.
# Never use production family tokens or commit these values.
BRITELINK_TEST_ENVIRONMENT=staging
BRITELINK_TEST_HOUSEHOLD_A_ID=household-a-uuid
BRITELINK_TEST_HOUSEHOLD_B_ID=household-b-uuid
BRITELINK_TEST_ADMIN_A_JWT=short-lived-household-a-admin-access-token
BRITELINK_TEST_ADMIN_B_JWT=short-lived-household-b-admin-access-token

# Mutation-denial matrix (D2), same staging project. Three household A actors, each proved to
# hold its role before any probe runs, plus one real household B row id per surface. The matrix
# sends cross-household write attempts that must all be denied, so never point it at production.
# BRITELINK_TEST_ADMIN_A_JWT and BRITELINK_TEST_ADMIN_B_JWT are reused from above.
BRITELINK_TEST_GUARDIAN_A_JWT=short-lived-household-a-guardian-access-token
BRITELINK_TEST_GUARDIAN_A_USER_ID=household-a-guardian-user-uuid
BRITELINK_TEST_EDUCATOR_A_JWT=short-lived-household-a-educator-access-token
BRITELINK_TEST_EDUCATOR_A_USER_ID=household-a-educator-user-uuid
BRITELINK_TEST_ADMIN_A_USER_ID=household-a-admin-user-uuid
BRITELINK_TEST_HOUSEHOLD_B_CASE_ID=household-b-case-uuid
BRITELINK_TEST_HOUSEHOLD_B_PLAN_ID=household-b-plan-uuid
BRITELINK_TEST_HOUSEHOLD_B_LESSON_ID=household-b-lesson-uuid
BRITELINK_TEST_HOUSEHOLD_B_ACTIVITY_ID=household-b-activity-uuid
BRITELINK_TEST_HOUSEHOLD_B_MESSAGE_ID=household-b-message-uuid
BRITELINK_TEST_HOUSEHOLD_B_DELIVERY_ID=household-b-delivery-uuid
BRITELINK_TEST_HOUSEHOLD_B_REVISION_ID=household-b-revision-uuid
BRITELINK_TEST_HOUSEHOLD_B_ATTACHMENT_ID=household-b-attachment-uuid
BRITELINK_TEST_HOUSEHOLD_B_CONSENT_ID=household-b-consent-uuid
BRITELINK_TEST_HOUSEHOLD_B_LEARNER_ID=household-b-learner-uuid
BRITELINK_TEST_HOUSEHOLD_B_CAPTURE_ID=household-b-learning-capture-uuid
BRITELINK_TEST_HOUSEHOLD_B_SHARED_ACTIVITY_ID=household-b-shared-activity-uuid
BRITELINK_TEST_HOUSEHOLD_B_OBJECT_PATH=household-b-uuid/case-uuid/attachment-uuid.pdf
BRITELINK_TEST_ATTACHMENT_BUCKET=case-attachments

# Staging journey suite (npm run test:staging-journeys, #39). STAGING ONLY: the service key mints
# sign-in links for the synthetic seed accounts. The suite refuses production hosts.
BRITELINK_STAGING_APP_URL=https://your-staging-app-host
BRITELINK_STAGING_SERVICE_ROLE_KEY=staging-service-role-key-never-production
