# Public browser configuration only. Never place a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Set only after the exact production notice language has qualified-counsel approval.
VITE_PRIVACY_NOTICE_VERSION=

# Trusted monitoring environment only. Never expose the monitor JWT to Vite/browser code.
BRITELINK_SUPABASE_URL=https://your-project.supabase.co
BRITELINK_SUPABASE_ANON_KEY=your-public-anon-key
BRITELINK_MONITOR_JWT=short-lived-dedicated-admin-access-token
BRITELINK_MONITOR_HOUSEHOLD_ID=household-uuid

# Staging-only isolation check. Use two distinct synthetic-household users.
# Never use production family tokens or commit these values.
BRITELINK_TEST_ENVIRONMENT=staging
BRITELINK_TEST_HOUSEHOLD_A_ID=household-a-uuid
BRITELINK_TEST_HOUSEHOLD_B_ID=household-b-uuid
BRITELINK_TEST_ADMIN_A_JWT=short-lived-household-a-admin-access-token
BRITELINK_TEST_ADMIN_B_JWT=short-lived-household-b-admin-access-token
