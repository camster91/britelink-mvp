# nginx config TEMPLATE, rendered at container start by the nginx image's own
# /docker-entrypoint.d/20-envsubst-on-templates.sh, which reads /etc/nginx/templates/*.template
# and writes the result to /etc/nginx/conf.d/ with the suffix stripped.
#
# It is a template for exactly one reason: the Content-Security-Policy has to name the API origin,
# and an origin cannot be hardcoded here because the same image serves both modes. The value comes
# from BRITELINK_API_ORIGIN, which compose derives from the SAME variable as the JS bundle's
# VITE_SUPABASE_URL -- so the policy and the code cannot disagree about where the API lives.
#
# That coupling is also what makes demo mode honest. With no API configured the variable is empty
# and the directive renders as `connect-src 'self' ` -- the tight policy the current production site
# already ships, not a loosened one left over from a live build. (The trailing space is the empty
# substitution; CSP ignores surrounding whitespace, so it is inert. `nginx -t` accepts it.)
#
# BRITELINK_API_ORIGIN must be DEFINED, even when empty -- the Dockerfile sets it to "" for exactly
# this reason. Measured on nginx:1.25-alpine, same template, three states:
#
#   set to the origin   -> connect-src 'self' https://britelink-api.ashbi.ca   nginx -t PASSES
#   defined, empty      -> connect-src 'self'                                  nginx -t PASSES
#   UNDEFINED           -> connect-src 'self' ${BRITELINK_API_ORIGIN}          nginx -t FAILS
#
# The last row is the trap. envsubst's substitution list is built from env names that MATCH THE
# FILTER, not from names the template uses -- so an unset variable is never substituted and its
# `$name` survives into the rendered file, where nginx reads it as an unknown variable and refuses
# to start at all. That is a total outage at container start, not a degraded header.
#
# NGINX_ENVSUBST_FILTER=BRITELINK_ is MANDATORY and is set in the Dockerfile. Without it envsubst
# substitutes EVERY $name it recognises, and `$uri` below becomes the empty string -- turning
# `try_files $uri $uri/ /index.html` into `try_files  /index.html`, which silently breaks every
# deep link in a single-page app whose whole routing model depends on that fallback. The filter
# restricts substitution to variables beginning with BRITELINK_, which is why no other $name in
# this file needs escaping.

# Calendar subscription feed (#47): one bucket per feed URL, so a misbehaving calendar client polling
# one link cannot hammer the API. Guessing a link is not the threat -- tokens carry 244 random bits.
limit_req_zone $uri zone=calendar_feed:2m rate=20r/m;

server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # HSTS. TLS terminates at Traefik, which sets stsSeconds for its other routes but NOT for
    # the two britelink routers (britelink.yml declares only tls.certResolver). Setting it here
    # is the defensive fix that lives in this repository: the header reaches the browser on
    # every response this container serves, so it does not depend on the edge config staying
    # right. Traefik passes our headers through; it does not strip them.
    #
    # includeSubDomains is omitted deliberately. It would also bind anything else under
    # ashbi.ca reached from this host, and this repo does not own that decision.
    add_header Strict-Transport-Security "max-age=31536000" always;
    # connect-src is the one directive that widens, and only to a single named origin. Never '*':
    # this app handles children's education records, and a wildcard would let any script that ever
    # reaches the page exfiltrate an authenticated session's data to anywhere.
    #
    # style-src has NO 'unsafe-inline'. That exception used to be required by two inline-styled
    # bootstrap error screens in src/main.jsx; those now use the .boot-fallback classes, so the
    # exception was dropped. Fonts are self-hosted under /fonts (previously an @import from
    # fonts.googleapis.com, which this policy blocked -- the browser silently fell back to system
    # fonts and logged a CSP violation on every load).
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${BRITELINK_API_ORIGIN}; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Calendar subscription feed (#47, migration 050). Calendar apps cannot sign in, so this proxies
    # /feed/<64-hex token>.ics to the one anon-executable RPC, public.calendar_feed(token), asking
    # PostgREST for text/plain and answering text/calendar. Anything the RPC refuses (revoked,
    # rotated, consent withdrawn, unknown) becomes a plain 404 with no detail.
    #
    # The upstream is a variable so an unconfigured (demo) build still starts: BRITELINK_API_ORIGIN
    # is empty there and the route answers 404. A variable proxy_pass needs a resolver; 127.0.0.11
    # is Docker's embedded DNS, which every compose container has.
    #
    # BRITELINK_API_ANON_KEY is the public anon key the bundle already ships to every browser; the
    # Dockerfile derives it from the same build arg and keeps it defined (empty) for the demo.
    #
    # add_header here replaces the server-level headers for this location (nginx does not merge
    # them), so the ones that matter for a non-HTML response are repeated. access_log is off because
    # the path is the credential.
    location ~ "^/feed/(?<feed_token>[0-9a-f]{64})\.ics$" {
        access_log off;
        limit_req zone=calendar_feed burst=10 nodelay;
        limit_req_status 429;
        set $feed_api "${BRITELINK_API_ORIGIN}";
        if ($feed_api = "") {
            return 404;
        }
        resolver 127.0.0.11 valid=300s ipv6=off;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header apikey "${BRITELINK_API_ANON_KEY}";
        proxy_set_header Authorization "Bearer ${BRITELINK_API_ANON_KEY}";
        proxy_set_header Accept "text/plain";
        proxy_set_header Cookie "";
        proxy_pass_request_body off;
        proxy_intercept_errors on;
        error_page 400 401 403 404 406 = @calendar_feed_gone;
        proxy_hide_header Content-Type;
        proxy_hide_header Set-Cookie;
        add_header Content-Type "text/calendar; charset=utf-8" always;
        add_header Cache-Control "private, max-age=900" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        proxy_pass $feed_api/rest/v1/rpc/calendar_feed?token=$feed_token;
    }

    location @calendar_feed_gone {
        access_log off;
        add_header X-Content-Type-Options nosniff always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        return 404;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
