{
  "services": {
    "web": {
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile",
        "args": {
          "VITE_SUPABASE_URL": "${VITE_SUPABASE_URL:-}",
          "VITE_SUPABASE_ANON_KEY": "${VITE_SUPABASE_ANON_KEY:-}",
          "VITE_PRIVACY_NOTICE_VERSION": "${VITE_PRIVACY_NOTICE_VERSION:-}",
          "VITE_ATTACHMENTS_ENABLED": "${VITE_ATTACHMENTS_ENABLED:-}",
          "BRITELINK_BUILD_COMMIT": "${SOURCE_COMMIT}"
        }
      },
      "restart": "unless-stopped",
      "expose": [
        "80"
      ]
    }
  }
}
