{
  "name": "britelink-mvp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:a11y": "node scripts/a11y-audit.mjs",
    "test:authenticated": "node scripts/authenticated-workspace-audit.mjs",
    "test:staff": "node scripts/staff-workspace-audit.mjs",
    "test:staff-attachments": "node scripts/staff-attachment-recovery-audit.mjs",
    "test:households": "node scripts/multi-household-audit.mjs",
    "test:restore": "bash scripts/local-restore-drill.sh",
    "test:migrations": "bash scripts/migration-harness/validate-migrations.sh",
    "health:hosted": "node scripts/hosted-health-check.mjs",
    "verify:hosted-isolation": "node scripts/hosted-isolation-check.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:restore:production": "bash scripts/production-restore-drill.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@electric-sql/pglite": "^0.5.8",
    "playwright": "^1.55.0"
  }
}
